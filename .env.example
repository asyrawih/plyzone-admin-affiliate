# ---- API ----
PORT=3000
APP_URL=http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:5173

# Postgres: transaksional (Bun.sql) + analitik (DuckDB ATTACH read-only lewat jaringan).
# Lokal: `docker compose up -d postgres` lalu URL di bawah. Test memakai TEST_DATABASE_URL (default sama) dan
# membuat database sekali pakai `klsm_test_*` per run.
DATABASE_URL=postgres://klsm:klsm@localhost:5433/klsm
TEST_DATABASE_URL=postgres://klsm:klsm@localhost:5433/klsm
# Ukuran pool Bun.sql per proses (DuckDB pakai ±3 koneksi sendiri di luar ini)
DB_POOL_MAX=10
# Folder ekstensi DuckDB. Di image produksi sudah berisi `postgres` (Dockerfile). Kosong = default (~/.duckdb), unduh sekali.
DUCKDB_EXTENSION_DIR=

# Cookie session owner (HttpOnly). true kalau di belakang HTTPS.
SESSION_SECURE=false
SESSION_TTL_HOURS=168

# Webhook bagi-bagi. Salah satu atau keduanya:
#  - shared secret: kirim header x-webhook-secret atau ?secret=
#  - HMAC-SHA256 raw body dengan header x-signature (hex/base64)
WEBHOOK_SHARED_SECRET=
WEBHOOK_HMAC_SECRET=

# Timezone untuk bucketing harian/bulanan di analitik
TZ_BUCKET=Asia/Jakarta

# Roblox Users API dipakai untuk resolve username -> userId (tanpa key)
ROBLOX_USERS_API=https://users.roblox.com

# Rate limit halaman publik /a/:token (request per menit per IP, per pod)
PUBLIC_RATE_LIMIT=60
